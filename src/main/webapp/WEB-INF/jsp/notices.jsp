<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.*" %><%@ page import="static com.sejongnuri.lab.JspUtil.h" %>
<% Map<String,Object> noticeDetail = (Map<String,Object>) request.getAttribute("notice"); %>
<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= h(request.getAttribute("pageTitle")) %></title><link rel="stylesheet" href="/assets/styles.css"></head>
<body data-page="notices"><%@ include file="fragments/header.jspf" %><main class="shell inner-page"><header class="page-heading"><h1>공지사항</h1><p>서비스 운영과 민원 이용에 필요한 소식을 알려드립니다.</p></header>
<% if (noticeDetail != null) { %><a class="back-link" href="/notices">← 목록으로 돌아가기</a><article class="notice-detail"><header><span class="kind <%= "important".equals(noticeDetail.get("kind")) ? "important" : "" %>"><%= "important".equals(noticeDetail.get("kind")) ? "중요" : "일반" %></span><h2><%= h(noticeDetail.get("title")) %></h2><time><%= h(noticeDetail.get("date")) %></time></header><div><%= h(noticeDetail.get("body")).replace("\n", "<br>") %></div></article>
<% } else { %><div class="notice-directory"><div class="notice-directory-head"><span>구분</span><span>제목</span><span>등록일</span></div><% for (Map<String,Object> notice : (List<Map<String,Object>>) request.getAttribute("notices")) { %><a href="/notices/<%= notice.get("id") %>"><span class="kind <%= "important".equals(notice.get("kind")) ? "important" : "" %>"><%= "important".equals(notice.get("kind")) ? "중요" : "일반" %></span><strong><%= h(notice.get("title")) %></strong><time><%= h(notice.get("date")) %></time><svg><use href="/assets/icons.svg#arrow-right"/></svg></a><% } %></div><% } %>
</main><%@ include file="fragments/footer.jspf" %><script src="/assets/app.js?v=20261118-2" defer></script></body></html>
