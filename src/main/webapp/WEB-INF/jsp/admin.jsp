<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="static com.sejongnuri.lab.JspUtil.h" %>
<!doctype html><html lang="ko"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= h(request.getAttribute("pageTitle")) %></title><link rel="stylesheet" href="/assets/styles.css"></head>
<body data-page="admin"><%@ include file="fragments/header.jspf" %><main class="shell inner-page admin-page">
  <header class="admin-heading"><div><h1>시민 서비스 관리자</h1><p>민원 처리와 시민 의견, 공지와 계정 현황을 관리합니다.</p></div><a class="secondary-button" href="/">시민포털 보기</a></header>
  <div class="admin-layout"><nav class="admin-nav" aria-label="포털 관리자 메뉴"><strong>관리 메뉴</strong><button class="active" data-admin-tab="overview">현황</button><button data-admin-tab="applications">민원 처리</button><button data-admin-tab="posts">시민 의견</button><button data-admin-tab="notices">공지 관리</button><button data-admin-tab="accounts">계정 조회</button></nav>
  <section class="admin-content"><div class="form-message global-message" role="status" hidden></div>
    <div data-admin-panel="overview"><div class="admin-stats"><div><span>시민 계정</span><strong data-count="citizens">—</strong></div><div><span>전체 민원</span><strong data-count="applications">—</strong></div><div><span>처리할 민원</span><strong data-count="pending">—</strong></div><div><span>시민 의견</span><strong data-count="posts">—</strong></div></div><section class="panel"><div class="panel-heading"><h2>최근 민원</h2><button class="secondary-button" data-show-tab="applications">전체 보기</button></div><div class="data-table admin-applications compact-table"></div></section><section class="panel"><div class="panel-heading"><h2>최근 공지</h2><button class="secondary-button" data-show-tab="notices">공지 관리</button></div><div class="simple-list admin-recent-notices"></div></section></div>
    <div data-admin-panel="applications" hidden><section class="panel"><h2>민원 처리</h2><p>접수된 민원의 진행 상태를 관리합니다.</p><div class="data-table admin-applications"></div></section></div>
    <div data-admin-panel="posts" hidden><section class="panel"><h2>시민 의견 관리</h2><p>게시판에 등록된 의견을 확인하고 관리합니다.</p><div class="post-list admin-posts"></div></section></div>
    <div data-admin-panel="notices" hidden><section class="panel"><h2>새 공지 등록</h2><form class="stack-form" id="notice-form"><label>공지 분류<select name="kind"><option value="normal">일반</option><option value="important">중요</option></select></label><label>공지 제목<input name="title" maxlength="120" placeholder="공지 제목을 입력하세요" required></label><label>공지 내용<textarea name="body" rows="6" maxlength="3000" placeholder="시민에게 안내할 내용을 입력하세요" required></textarea></label><button class="primary-button">공지 등록</button></form></section><section class="panel"><h2>등록된 공지</h2><div class="simple-list admin-notices"></div></section></div>
    <div data-admin-panel="accounts" hidden><section class="panel"><h2>포털 계정 현황</h2><p>시민과 직원의 포털 계정을 확인합니다.</p><div class="data-table admin-accounts"></div></section></div>
  </section></div>
</main><%@ include file="fragments/footer.jspf" %><script src="/assets/app.js?v=20261118-3" defer></script></body></html>
